# Copy file này thành .env rồi điền giá trị thật: cp .env.example .env

# Finnhub - lấy key tại https://finnhub.io/dashboard
FINNHUB_API_KEY=

# MinIO (dùng chung cho container minio, consumer và DAG Airflow)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=

# Snowflake
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STOCK_MDS
SNOWFLAKE_SCHEMA=COMMON
